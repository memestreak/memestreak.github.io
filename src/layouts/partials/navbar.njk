<em-navbar>
  <em-home-link>
    <a href="/">
      <em-navbar-home-logo>
        <img src="/assets/img/eminor-logo.svg"
             alt="" class="svg-logo"
             width="44" height="44" />
      </em-navbar-home-logo>
      <em-navbar-home-text>
        eminor.net
      </em-navbar-home-text>
    </a>
  </em-home-link>

  <nav class="navbar-link-container">
    <ul class="em-navbar-link-list">
    {%- for link in navigation.main %}
      <li><a href="{{ link.url }}"
             {%- if link.description %} title="{{ link.description }}"{% endif %}
             {%- if navigation_id == link.id %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
    {%- endfor %}
    </ul>
  </nav>
</em-navbar>
<div class="navbar-strings" aria-hidden="true"></div>
